# ── KubeX Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit the .env file — it contains secrets.

# ── PostgreSQL (managed Supabase, EPIC "Move DB to Supabase" #817) ──
# The platform database is Supabase-hosted Postgres, not a local
# container. Every producer (ingest, agent) and consumer (MCP server,
# Grafana, migrations) connects to it via DATABASE_URL below.
#
# DATABASE_URL must be the SESSION POOLER connection string (Supabase
# dashboard: Settings -> Database -> Connection string -> "Session
# pooler" tab), NOT "Direct connection" (IPv6-only, breaks most home/
# office networks) and NOT "Transaction pooler" (breaks asyncpg
# prepared statements and LISTEN/NOTIFY; migrations need session mode).
# It looks like:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SQLAlchemy needs the asyncpg dialect prefix — use postgresql+asyncpg://
# for DATABASE_URL below (services/mcp-server's node `pg` client parses
# the same URL fine with the plain postgresql:// prefix; ingest/agent's
# db.py builds the asyncpg URL itself if you paste the plain form).
SUPABASE_PROJECT_REF=
SUPABASE_DB_REGION=
# The database password you set when creating the Supabase project
# (Settings -> Database to reset it if lost). Embedded in DATABASE_URL
# below — kept separate here only so scripts/docs can reference it.
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Discrete fields for Grafana's PostgreSQL datasource provisioning
# (deploy/grafana/datasources/datasources.yml expands these via
# Grafana's $__env{} syntax) — Grafana can't parse a connection URL.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# grafana_ro's Supavisor pooler username is "grafana_ro.<project-ref>",
# not the bare role name — Supabase's pooler requires "<role>.<ref>"
# for every role, not just postgres.
#
# SUPABASE_GRAFANA_RO_PASSWORD: V001__base_schema.sql creates this role
# with the placeholder password 'grafana_readonly' if it doesn't already
# exist. That's fine for a throwaway local Postgres, but this role now
# authenticates against an always-on, internet-reachable Supabase
# instance — rotate it before using this in anything but a disposable
# dev project: `ALTER ROLE grafana_ro WITH PASSWORD '<new-password>';`
# in the Supabase SQL editor, then set the real value below. Do NOT
# leave this as the migration's placeholder default.
SUPABASE_GRAFANA_RO_USER=grafana_ro.<project-ref>
SUPABASE_GRAFANA_RO_PASSWORD=change-me-rotate-this-in-supabase-sql-editor

# ── Local Postgres (opt-in escape hatch, `docker compose --profile local-db up`) ──
# Only used when running the compose `postgres` service instead of
# Supabase — e.g. offline dev. Ignored otherwise.
#
# KNOWN LIMITATION: Grafana's PostgreSQL datasource (datasources.yml)
# always reads the SUPABASE_DB_* vars above, with sslmode hardcoded to
# "require" — it has no local-db-profile variant. The local Postgres
# container has no TLS listener, so Grafana's PostgreSQL panel will not
# work against it out of the box. To get it working locally, point
# SUPABASE_DB_HOST=postgres, SUPABASE_DB_PORT=5432,
# SUPABASE_DB_NAME=kubex, SUPABASE_GRAFANA_RO_USER=grafana_ro,
# SUPABASE_GRAFANA_RO_PASSWORD=grafana_readonly (or your local role's
# password) above, AND edit datasources.yml's sslmode to "disable"
# locally (don't commit that edit — it would break the Supabase path).
POSTGRES_PASSWORD=kubex

# ── Ingest Service ───────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-secret
ARGOCD_WEBHOOK_TOKEN=change-me-to-a-random-token
ALERTMANAGER_WEBHOOK_TOKEN=change-me-to-a-random-token
# Fine-grained PAT with read-only "Contents" access, used by the safety
# score's files_changed factor (GET /repos/{repo}/commits/{sha}). Optional —
# that factor contributes 0 points if unset.
GITHUB_API_TOKEN=

# ── Prometheus, Loki & Alertmanager (port-forwarded from Kind) ─
# PROM_URL/LOKI_URL are the LEGACY/LOCAL-ONLY path (#840): used only for a
# service with no connected remote cluster (services.cluster_id IS NULL —
# the in-cluster Kind demo). A service on a connected customer cluster
# (EPIC-022) always goes through the org-scoped cluster_queries relay
# instead, never these — see app/cluster_relay.py / app/routers/prom.py.
PROM_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
ALERTMANAGER_URL=http://host.docker.internal:9093
# How long the relay endpoints (routers/prom.py, routers/relay_internal.py)
# block waiting for a cluster agent to answer a queued query. Tuned for a
# Grafana panel load / an async agent tick.
PROM_RELAY_TIMEOUT_SECONDS=20
# Short timeout for the safety score's cluster-utilization factor
# specifically (app/promql.py) — it runs synchronously inside the GitHub
# webhook handler, which must respond well inside GitHub's own webhook
# delivery timeout; the 20s default above would blow that budget.
SAFETY_SCORE_RELAY_TIMEOUT_SECONDS=4

# ── Detection Agent ──────────────────────────────────────────
BASELINE_WINDOW=30m
OBSERVATION_WINDOW=15m

# ── Slack Alerts (in-cluster Alertmanager -> Slack, platform/infra only) ──
# Incoming webhook URL for the #deploylens-alerts channel.
# Create one at https://api.slack.com/apps → Incoming Webhooks.
# Also update deploy/alertmanager/alertmanager-slack-secret.yaml.
# NOTE: per-tenant deploy alerts go through the KubeX Slack app below,
# not this webhook.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# ── KubeX Slack app (multi-tenant deploy notifications, E23-T5) ───
# ONE Slack app, distribution enabled, that every org installs into its
# own workspace via OAuth (mirrors the GitHub App model). Register at
# https://api.slack.com/apps → From scratch, then:
#   - OAuth & Permissions → Bot Token Scopes:
#       chat:write, chat:write.public, channels:read, groups:read
#   - OAuth & Permissions → Redirect URLs:
#       {INGEST_PUBLIC_URL}/integrations/slack/callback
#   - Event Subscriptions → Request URL:
#       {INGEST_PUBLIC_URL}/webhooks/slack/events
#     subscribe to bot events: app_uninstalled, tokens_revoked
#   - Manage Distribution → activate public distribution
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# "Signing Secret" from the app's Basic Information page — verifies
# inbound Events API requests.
SLACK_SIGNING_SECRET=
# Fernet key encrypting per-org Slack bot tokens at rest. REQUIRED once
# SLACK_CLIENT_ID is set (ingest and agent both need it). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENC_KEY=

# ── ArgoCD (port-forwarded from Kind at localhost:8443) ──────
# Retrieved via: kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d
ARGOCD_ADMIN_PASSWORD=

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=kubex
# Viewer-only service account token for the shell's Grafana panel
# proxy (E11-T2/T3). Generated by deploy/scripts/create-grafana-sa.sh
# — don't set this by hand.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Grafana origin the ingest service's panel proxy talks to.
GRAFANA_URL=http://grafana:3000
# Bearer the kubex-prometheus datasource sends to ingest's /api/prom
# relay (#832). Set the SAME value on the grafana and ingest containers.
# Generate: openssl rand -hex 32
GRAFANA_DATASOURCE_TOKEN=change-me-to-a-random-token
# How long /api/prom blocks waiting for the cluster agent to answer a
# relayed query before returning a Prometheus timeout error envelope.
PROM_RELAY_TIMEOUT_SECONDS=20
# Shared secret between the grafana and renderer containers (Grafana 13+
# refuses to start rendering without a non-default value here).
# Generate: openssl rand -hex 24
GRAFANA_RENDERER_TOKEN=change-me-to-a-random-token

# ── Chat (shell backend chat proxy, E11-T1) ──────────────────
# API key for the Gemini API (ai.google.dev — free tier available).
# Never exposed to the browser — the chat proxy in services/ingest
# holds it server-side.
GEMINI_API_KEY=
# Model used by the chat proxy (services/ingest/app/chat_engine.py).
# gemini-flash-latest's free tier is capped at 20 requests/day per
# project — gemini-flash-lite-latest has its own separate free-tier
# quota bucket, so it's the safer default for a single shared API key.
CHAT_MODEL=gemini-flash-lite-latest
# MCP server endpoint (Streamable HTTP transport, services/mcp-server).
MCP_SERVER_URL=http://mcp-server:3001/mcp
# Shared bearer token authenticating internal service-to-service calls —
# ingest -> the MCP server's HTTP transport (E20-T3), AND, in the reverse
# direction, the MCP server -> ingest's org-scoped telemetry relay
# (routers/relay_internal.py, #840). Same pattern as ARGOCD_WEBHOOK_TOKEN
# below. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_INTERNAL_TOKEN=change-me-to-a-random-token
# INGEST_URL is a container's own internal address for ingest — used by
# mcp-server's clients/ingest-relay.ts (#840) to reach the relay above,
# AND by the detection agent (agent/notify.py) to reach
# /internal/notify (Slack alert delivery — ingest is the only service
# holding Slack OAuth tokens). Distinct from INGEST_PUBLIC_URL below,
# which is the externally-reachable address embedded in cluster-agent
# install manifests — neither of these internal callers needs that one.
INGEST_URL=http://ingest:8000

# ── Blast radius discovery (E14-T3) ──────────────────────────
# K8s API server the detection agent discovers service dependencies from,
# plus a read-only ServiceAccount token/CA cert. Empty means the feature
# is disabled. Generated by deploy/scripts/create-blast-radius-sa.sh —
# don't set these by hand.
K8S_API_SERVER=
K8S_TOKEN=
K8S_CA_CERT_B64=
# How often blast-radius discovery re-runs.
BLAST_RADIUS_INTERVAL_SECONDS=300

# ── E2E smoke test (scripts/e2e_smoke_test.py, EPIC-018) ─────
# Path to a deploylens-sample-app checkout. Optional — defaults to a
# ../deploylens-sample-app sibling of this repo; only set if yours lives
# elsewhere.
SAMPLE_APP_REPO=

# ── GitHub OAuth login (E19-T2, EPIC-019) ─────────────────────
# From a GitHub OAuth App (https://github.com/settings/developers) with
# authorization callback URL set to http://localhost:8000/auth/github/callback
# in dev. Scopes requested: read:user, user:email.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session JWT cookie issued by /auth/github/callback. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# React shell origin the OAuth callback redirects the browser to after
# login (default matches the Vite dev server).
SHELL_URL=http://localhost:5173

# ── GitHub App (E21-T1, EPIC-021) ─────────────────────────────
# From a GitHub App registered at https://github.com/settings/apps/new
# (permissions: actions:read, contents:read, deployments:read; events:
# workflow_run, installation, deployment_status). Used for automatic
# webhook provisioning on org install, replacing the manual per-repo
# GITHUB_WEBHOOK_SECRET setup above.
GITHUB_APP_ID=
# Path to the .pem private key downloaded from the app's settings page.
# Never commit this file — keep it under the gitignored secrets/ dir,
# e.g. secrets/github-app.pem.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=change-me-to-a-random-secret

# ── Cluster Agent install manifests (E22-T2, EPIC-022) ────────
# Externally reachable address of this ingest service, embedded into
# generated cluster-agent install manifests (GET /install/:token.yaml) so
# the agent knows where to phone home. Must be reachable from inside the
# remote cluster, not just this host.
INGEST_PUBLIC_URL=http://localhost:8000
# Must be https:// in production — the cluster bearer token travels over
# this URL on every agent request. Set true only for local/dev testing
# against a plain-http INGEST_PUBLIC_URL (e.g. host.docker.internal).
ALLOW_INSECURE_INGEST_PUBLIC_URL=false
