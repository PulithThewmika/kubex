# Slug of the registered GitHub App (from its settings page URL), used to
# build the "Connect GitHub" install link. Defaults to "deploylens" if unset.
VITE_GITHUB_APP_SLUG=deploylens

# Public URL of the ingest service, embedded into the Add Cluster wizard's
# generated kubectl/Helm/GitOps install commands (E22-T5). These are
# copy-pasted and run outside the browser, so they can't rely on the same
# same-origin proxy apiFetch's calls do. Defaults to window.location.origin
# if unset, which is only correct when the shell and ingest share an origin.
VITE_INGEST_PUBLIC_URL=https://ingest.yourcompany.com
