# Slug of the registered GitHub App (from its settings page URL), used to
# build the "Connect GitHub" install link. Defaults to "deploylens" if unset.
VITE_GITHUB_APP_SLUG=deploylens

# Backend origin that api/proxy.ts forwards /api, /auth, /install,
# /integrations and /mcp to. Deliberately unprefixed (not VITE_*) so it's
# never bundled into client JS. Set the real value only in the Vercel
# dashboard's Environment Variables, never commit it here.
BACKEND_URL=http://localhost:8000
